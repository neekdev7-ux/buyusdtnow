# TRX → USDT Exchange — env vars (ALL VALUES ARE PLACEHOLDERS — replace with your own)
# Copy to .env.local and fill in. NEVER commit .env.local or real secrets.

# --- Supabase (required) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# --- Telegram bot (required for initData verification + webhook) ---
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
NEXT_PUBLIC_APP_URL=https://YOUR_APP.vercel.app
# Bot identity for referral links t.me/<bot>/<app>?startapp=ref_<ID>
TELEGRAM_BOT_USERNAME=YourTrxUsdtBot
TELEGRAM_APP_SHORT_NAME=your_app_short_name
OFFICIAL_CHANNEL_USERNAME=YourChannel
# Your Telegram user ID — receives new-join, payment, payout + support alerts
ADMIN_TELEGRAM_ID=YOUR_TELEGRAM_USER_ID

# --- Exchange settings (defaults shown; can also be changed in /admin) ---
FIXED_TRX_PER_USDT=3.50
MIN_BUY_USDT=1000
MAX_BUY_USDT=100000
ORDER_EXPIRY_MINUTES=30
# TRX wallet that RECEIVES customer payments (your wallet — public address only)
TRX_PAYMENT_ADDRESS=TREPLACE_WITH_YOUR_TRX_RECEIVE_ADDRESS
# USDT TRC20 hot wallet that SENDS USDT to customers (public address only)
USDT_HOT_WALLET_ADDRESS=TREPLACE_WITH_YOUR_USDT_HOT_WALLET_ADDRESS
SUPPORT_USERNAME=YourSupport

# --- Auto-send USDT (DEFAULT OFF — manual admin payout) ---
# Set to "true" ONLY if you understand the risk. Requires the hot-wallet
# PRIVATE KEY below and MAX_AUTO_SEND_USDT cap. Never share this key.
AUTO_SEND_USDT=false
MAX_AUTO_SEND_USDT=5000
USDT_HOT_WALLET_PRIVATE_KEY=YOUR_USDT_HOT_WALLET_PRIVATE_KEY_ONLY_IF_AUTO_SEND

# --- Admin panel ---
ADMIN_PASSWORD=CHOOSE_A_STRONG_ADMIN_PASSWORD

# --- Cron protection (optional but recommended) ---
CRON_SECRET=CHOOSE_A_RANDOM_CRON_SECRET

# --- TronGrid (optional; raises API rate limits) ---
TRONGRID_API_KEY=
